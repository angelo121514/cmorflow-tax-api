# CmorFlow Tax API — Variables de entorno

NODE_ENV=development
PORT=3000

# ---- Base de datos (Supabase / Postgres) ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=sii_db
DB_SCHEMA=public
DB_SSL=false

# ---- Tax API ----
INTEGRATIONS_API_ENABLED=true
INTEGRATION_HMAC_WINDOW_SECONDS=300
INTEGRATION_RATE_LIMIT_PER_MIN=60
INTEGRATION_URL_SECRET=

# ---- Motor SII ----
SII_MASTER_KEY=CHANGE_ME_GENERATE_A_SECURE_32_CHAR_KEY
SII_INTEGRATION_MODE=mock
SII_ENVIRONMENT=certification
SII_XSD_VALIDATION_ENABLED=false

# ---- CORS ----
CORS_ORIGINS=

# ---- Migraciones ----
AUTO_RUN_MIGRATIONS=false