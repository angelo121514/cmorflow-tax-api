# CmorFlow Tax API — Variables de entorno

NODE_ENV=development
PORT=3000

# ---- Base de datos (Supabase / Postgres) ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=sii_db
DB_SCHEMA=public
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# ---- Tax API ----
INTEGRATIONS_API_ENABLED=true
INTEGRATION_HMAC_WINDOW_SECONDS=300
INTEGRATION_RATE_LIMIT_PER_MIN=60
INTEGRATION_URL_SECRET=

# ---- Motor SII ----
SII_MASTER_KEY=CHANGE_ME_GENERATE_A_SECURE_32_CHAR_KEY
SII_INTEGRATION_MODE=mock
SII_ENVIRONMENT=certification
SII_XSD_VALIDATION_ENABLED=false
# Overrides SII opcionales; por defecto se derivan del ambiente/baseUrl.
SII_BASE_URL=
SII_SEED_URL=
SII_TOKEN_URL=
SII_UPLOAD_URL=
SII_UPLOAD_BOLETA_URL=
# Obligatoria sólo con SII_INTEGRATION_MODE=real para transmitir RCOF.
SII_UPLOAD_RCOF_URL=
SII_QUERY_UPLOAD_STATUS_URL=
SII_QUERY_DTE_ADVANCED_STATUS_URL=
SII_SENDER_RUT=
SII_REQUEST_TIMEOUT_MS=30000

# ---- Producción / operación ----
HTTP_BODY_LIMIT=1mb
API_DOCS_ENABLED=true
METRICS_ENABLED=false
METRICS_BEARER_TOKEN=
INTEGRATION_WORKER_ENABLED=false
INTEGRATION_WORKER_INTERVAL_MS=60000
RCOF_DAILY_HOUR=6
CRON_HMAC_SECRET=

# ---- CORS ----
CORS_ORIGINS=

# ---- Migraciones ----
AUTO_RUN_MIGRATIONS=false
