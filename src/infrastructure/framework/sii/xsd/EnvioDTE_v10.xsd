<?xml version="1.0" encoding="ISO-8859-1"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://www.sii.cl/SiiDte"
           xmlns="http://www.sii.cl/SiiDte"
           elementFormDefault="qualified">

  <xs:element name="EnvioDTE">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="SetDTE">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Caratula">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="RutEmisor" type="xs:string"/>
                    <xs:element name="RutEnvia" type="xs:string"/>
                    <xs:element name="RutReceptor" type="xs:string"/>
                    <xs:element name="FchResol" type="xs:string"/>
                    <xs:element name="NroResol" type="xs:integer"/>
                    <xs:element name="TmstFirmaEnv" type="xs:string"/>
                  </xs:sequence>
                  <xs:attribute name="version" type="xs:string" use="required"/>
                </xs:complexType>
              </xs:element>
              <!-- Permite cualquier contenido XML del DTE interno en esta validación ágil local -->
              <xs:any namespace="##any" processContents="lax" minOccurs="1" maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:attribute name="ID" type="xs:string" use="required"/>
          </xs:complexType>
        </xs:element>
        <!-- Bloque de firma digital oficial del sobre EnvioDTE -->
        <xs:any namespace="##any" processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="version" type="xs:string" use="required"/>
      <xs:attribute name="ID" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

</xs:schema>
