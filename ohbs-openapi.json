        "responses": {
          "202": {
            "description": "Solicitud aceptada y encolada."
          },
          "409": {
            "description": "Conflicto de idempotencia o externalReference."
          },
          "422": {
            "description": "Validación tributaria o totales."
          }
        },
        "summary": "Emitir un DTE (33/34/39/41/46/52) de forma asíncrona",
        "tags": [
          "dtes"
        ]
      },
