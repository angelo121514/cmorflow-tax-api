{
  "name": "cmorflow-tax-api",
  "version": "1.0.0",
  "description": "CmorFlow Tax API — plataforma tributaria B2B para facturación electrónica chilena vía API",
  "private": true,
  "license": "UNLICENSED",
  "engines": { "node": ">=22.12.0 <23" },
  "scripts": {
    "build": "npx nest build",
    "start": "npx nest start",
    "start:dev": "npx nest start --watch",
    "start:prod": "node dist/src/main",
    "test": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "openapi:check": "ts-node -r tsconfig-paths/register scripts/check-openapi-drift.ts",
    "openapi:update": "ts-node -r tsconfig-paths/register scripts/check-openapi-drift.ts --update",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli",
    "migration:run": "npm run typeorm -- -d src/database/data-source.ts migration:run",
    "migration:generate": "npm run typeorm -- -d src/database/data-source.ts migration:generate"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.4.3",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.1",
    "bwip-js": "^4.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "decimal.js": "^10.6.0",
    "fast-xml-parser": "^5.8.0",
    "helmet": "^8.2.0",
    "nest-winston": "^1.10.2",
    "nestjs-cls": "^6.2.0",
    "node-forge": "^1.4.0",
    "pdfkit": "^0.18.0",
    "pg": "^8.21.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.30",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.1",
    "@types/node-forge": "^1.3.14",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.9.3"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": { "^.+\\.(t|j)s$": "ts-jest" },
    "collectCoverageFrom": ["**/*.(t|j)s"],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@domain/(.*)$": "<rootDir>/domain/$1",
      "^@domain$": "<rootDir>/domain/index",
      "^@application/(.*)$": "<rootDir>/application/$1",
      "^@application$": "<rootDir>/application/index",
      "^@infrastructure/(.*)$": "<rootDir>/infrastructure/$1",
      "^@infrastructure$": "<rootDir>/infrastructure/index",
      "^@controllers/(.*)$": "<rootDir>/controllers/$1",
      "^@controllers$": "<rootDir>/controllers/index"
    }
  }
}